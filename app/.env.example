# Supabase PostgreSQL runtime connection.
# Recommended for app runtime: Supabase pooler connection string.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Recommended for Drizzle migrations: Supabase direct database connection string.
DIRECT_DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
# POSTGRES_URL_NON_POOLING="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase hosted databases require SSL. Keep prepared statements disabled for pooler compatibility.
POSTGRES_SSL=require
POSTGRES_PREPARE=false
POSTGRES_POOL_MAX=10
DRIZZLE_LOG=false

# Authentication.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional LLM mode for AI chatbot. Without this, the app uses local semantic fallback.
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-4.1-mini

# Optional OpenAI-compatible provider mode.
# LLM_API_KEY=your-provider-key
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_PROVIDER=openai-compatible

# Optional legacy SQLite source for one-time migration into Supabase PostgreSQL.
# SQLITE_DATABASE_URL=file:./data/omnichannel.sqlite
# MIGRATION_BATCH_SIZE=500
